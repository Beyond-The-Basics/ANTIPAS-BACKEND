# Copy to .env and adjust. Values here match docker-compose defaults for local dev.
ENVIRONMENT=local

DATABASE_URL=postgresql+asyncpg://antipas:antipas@localhost:5432/antipas

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Path to the Firebase service-account JSON (phone/OTP auth). Leave unset to disable.
FIREBASE_CREDENTIALS_PATH=

ADMIN_SECRET_KEY=change-me

# JWT email+password auth. Generate a real key before deploying anywhere real:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ENVIRONMENT=production refuses to boot while this is still the default.
JWT_SECRET_KEY=dev-only-insecure-jwt-signing-key-change-me-in-production
JWT_ALGORITHM=HS256
# 7 days. Long because there is no refresh token yet.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

LISTING_EXPIRY_HOURS=72

# Transactional email, used for email-verification codes. Brevo is the active provider; leave the
# key unset locally — without it the app logs "would have sent" instead of calling out, so dev and
# tests never send real mail. EMAIL_FROM must be a sender validated in your Brevo account
# (Senders → Add a sender); Brevo rejects sends from an unvalidated address.
# Get the key from Brevo → SMTP & API → API Keys.
BREVO_API_KEY=
# RESEND_API_KEY is honored too if you'd rather use Resend (kept as a drop-in alternative).
RESEND_API_KEY=
EMAIL_FROM=Kickoff <no-reply@example.com>

# Email-verification OTP policy.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_INTERVAL_SECONDS=60
