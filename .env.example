# Copy to .env and adjust. Values here match docker-compose defaults for local dev.
ENVIRONMENT=local

DATABASE_URL=postgresql+asyncpg://antipas:antipas@localhost:5432/antipas

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Path to the Firebase service-account JSON (phone/OTP auth). Leave unset to disable.
FIREBASE_CREDENTIALS_PATH=

ADMIN_SECRET_KEY=change-me

LISTING_EXPIRY_HOURS=72
